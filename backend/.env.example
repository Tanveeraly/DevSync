# ──────────────────────────────────────────────────────────────────────────────
# Environment variables for the ProjectBoard API
# Copy to .env and fill in real values before running.
# ──────────────────────────────────────────────────────────────────────────────

# App
APP_NAME="ProjectBoard API"
APP_VERSION="0.1.0"
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL via asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/projectboard

# JWT / Auth
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins handled by pydantic)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# Encryption (for GitHub tokens at rest – must be 32 bytes)
ENCRYPTION_KEY=change-me-32-byte-key-in-prod!!

# Password Reset
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Email / SMTP (leave SMTP_HOST blank to use console-log fallback in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@devsync.local
